APP_NAME="Beaker Breakers Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi
APP_URL=http://localhost:8000

# The Next.js web portal. Used for CORS and for password-reset links.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=beaker_breakers
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=1440

# Swap both to redis once Redis is running (NFR-02, FR-07.2).
CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=localhost:3000
SANCTUM_TOKEN_HOURS=24

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@beakerbreakers.app"
MAIL_FROM_NAME="${APP_NAME}"

# External services. Leave GEMINI_API_KEY empty to prove NFR-06:
# every experiment must stay completable on pre-authored guidance alone.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_ID=
FCM_SERVER_KEY=
SENDGRID_API_KEY=
