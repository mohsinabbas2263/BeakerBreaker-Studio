    A3 --> A4["Request AI step guidance"]
    A4 --> D2{"Gemini API available"}
    D2 -->|"yes"| A5["Display Beaky guidance within 2 s"]
    D2 -->|"no"| A6["Display pre-written fallback hint (NFR-06)"]
