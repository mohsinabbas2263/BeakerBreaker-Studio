%% ---------------------------------------------------------------------
%% Figure 9: Activity Diagram — Safety Certification
%% SRS source: SRS §11.2 FR-02.1 to FR-02.6; §14 DR-02; §15 IR-10; §20 UC-02
%% ---------------------------------------------------------------------
flowchart TB
    ST(("Start")) --> A1["Open Safety Training"]
    A1 --> A2["System presents lowest unlocked tier N"]
    A2 --> A3["System randomises questions from tier N bank (FR-02.3)"]
    A3 --> A4["Student submits answers"]
    A4 --> A5["System computes score server-side (IR-05)"]
    A5 --> D1{"score &gt;= 80 percent"}
    D1 -->|"no"| A6["Display result with retry option (FR-02.6)"]
    A6 --> A3
    D1 -->|"yes"| A7["Mark tier N passed, unlock tier N+1, award 50 XP"]
    A7 --> D2{"N = 4"}
    D2 -->|"no"| A2
    D2 -->|"yes"| A8["Issue certificate with UUID and four tier scores (FR-02.4)"]
    A8 --> A9["Display on student profile and teacher safety review (FR-02.5)"]
    A9 --> EN((("End")))


%% ---------------------------------------------------------------------
%% Figure 10: Activity Diagram — Perform Virtual Experiment
%% SRS source: SRS §11.3-11.4, §11.6-11.7; §12 NFR-05, NFR-06; §15 IR-02, IR-05; §20 UC-03
