<mxfile host="Electron">
  <diagram id="B3HZ055_rw6REhJLXg7l" name="Page-1">
    <mxGraphModel dx="1964" dy="1252" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  theme: neutral\n  themeVariables:\n    fontFamily: Arial\n    fontSize: 15px\n    lineColor: \&quot;#000000\&quot;\n    edgeLabelBackground: \&quot;#ffffff\&quot;\n  flowchart:\n    curve: basis\n    nodeSpacing: 45\n    rankSpacing: 135\n    htmlLabels: true\n---\n\n%% Figure: Gamification Use Case Diagram\n%% Beaker Breakers Studio\n%% Scope: experience points, badges, rank levels, streaks, missions, leaderboard\n%% Source: Chapter 3 requirements FR-06.1 to FR-06.5, FR-07.1 to FR-07.3,\n%%         FR-04.3, NFR-05\n%%         SRS Section 20, UC-10 Earn Rewards,\n%%         UC-11 Daily Missions and Streaks, UC-12 View Leaderboard\n\n%% Shape note: Mermaid has no ellipse shape. Use cases are drawn here with the\n%% stadium shape ([text]). The Graphviz version of this figure uses true UML\n%% ellipses and is the one to place in the report.\n\nflowchart LR\n\n    %% ================= Actors =================\n    Student[\&quot;Student\&quot;]\n    Teacher[\&quot;Teacher\&quot;]\n    Pusher[\&quot;Pusher&lt;br/&gt;&amp;lt;&amp;lt;external&amp;gt;&amp;gt;\&quot;]\n\n    %% ================= System boundary =================\n    subgraph SYS[\&quot;Beaker Breakers Studio (Gamification Scope)\&quot;]\n        UC10([\&quot;UC-10&lt;br/&gt;Earn Rewards\&quot;])\n        XP([\&quot;Award Experience Points by Experiment&lt;br/&gt;Difficulty or Safety Tier Passed\&quot;])\n        BADGE([\&quot;Award a Badge Once&lt;br/&gt;from the Badge Set\&quot;])\n        RANK([\&quot;Assign One of Eight Rank Levels\&quot;])\n\n        UC11([\&quot;UC-11&lt;br/&gt;Daily Missions and Streaks\&quot;])\n        MISS([\&quot;Present Three Daily Missions\&quot;])\n        RESET([\&quot;Replace the Missions at Midnight PKT\&quot;])\n        STREAK([\&quot;Record Consecutive Days of Activity\&quot;])\n        SBADGE([\&quot;Award a Streak Badge at&lt;br/&gt;7, 30 and 100 Days\&quot;])\n\n        UC12([\&quot;UC-12&lt;br/&gt;View Leaderboard\&quot;])\n        FIELDS([\&quot;Show Display Name, Avatar,&lt;br/&gt;Rank Level and Points Only\&quot;])\n        PUSHUC([\&quot;Reflect a Points Change&lt;br/&gt;Within 2 Seconds\&quot;])\n\n        %% context: the two events that cause rewards to be awarded\n        UC09([\&quot;UC-09&lt;br/&gt;Take Knowledge Quiz\&quot;])\n        UC02([\&quot;UC-02&lt;br/&gt;Safety Certification\&quot;])\n    end\n\n    %% ================= Actor associations =================\n    %% UC-10 carries no direct actor association: rewards are awarded by the\n    %% system as a consequence of UC-09 or UC-02, not initiated by the student.\n    Student --- UC09\n    Student --- UC02\n    Student --- UC11\n    Student --- UC12\n    Teacher --- UC12\n    PUSHUC --- Pusher\n\n    %% ================= Include relationships =================\n    UC09 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-04.3\&quot;| UC10\n    UC02 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-06.1\&quot;| UC10\n\n    UC10 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-06.1\&quot;| XP\n    UC10 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-06.3\&quot;| BADGE\n    UC10 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-06.4\&quot;| RANK\n\n    UC11 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-07.3\&quot;| MISS\n    UC11 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-07.3\&quot;| RESET\n    UC11 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-06.5\&quot;| STREAK\n\n    UC12 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-07.1\&quot;| FIELDS\n    UC12 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-07.2\&quot;| PUSHUC\n\n    %% ================= Extend relationship =================\n    SBADGE -.-&gt;|\&quot;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt; FR-06.5&lt;br/&gt;[streak reaches 7, 30 or 100 days]\&quot;| UC11\n\n    %% ================= Constraint notes =================\n    %% FR-06.2: experience points are never awarded for the speed at which a\n    %%          student completes an experiment or a quiz.\n    %% FR-06.4: a student&#39;s points or rank level are never reduced by any\n    %%          operation.\n    %% NFR-05: no awarded point or badge is lost to a refresh, a session expiry\n    %%         or a network interruption.\n\n    %% ================= Styling (outline only, no fill colour) =================\n    classDef actor fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000\n    classDef ext fill:#ffffff,stroke:#000000,stroke-width:1.5px,stroke-dasharray:5 4,color:#000000\n    classDef uc fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000\n\n    class Student,Teacher actor\n    class Pusher ext\n    class UC10,XP,BADGE,RANK,UC11,MISS,RESET,STREAK,SBADGE uc\n    class UC12,FIELDS,PUSHUC,UC09,UC02 uc\n\n    style SYS fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="37">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
