# deploy/.env on the server only, never in git. Values for docker-compose itself;
# the Laravel settings are in backend/.env (see docs/deploy.md).

# The API's public name; Caddy gets its HTTPS certificate for it.
API_DOMAIN=api.example.com

# Must match DB_DATABASE, DB_USERNAME and DB_PASSWORD in backend/.env.
DB_DATABASE=beaker_breakers
DB_USERNAME=beaker
DB_PASSWORD=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# SR-10: encrypts every backup. Keep a copy of it outside the server: without it the
# backups cannot be read.
BACKUP_PASSPHRASE=
