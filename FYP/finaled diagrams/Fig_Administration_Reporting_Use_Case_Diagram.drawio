        <mxCell id="-DrFvxi9EPpmsSaKXJQn-44" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="995" width="1734" x="-60" as="geometry" />
        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  theme: neutral\n  themeVariables:\n    fontFamily: Arial\n    fontSize: 15px\n    lineColor: \&quot;#000000\&quot;\n    edgeLabelBackground: \&quot;#ffffff\&quot;\n  flowchart:\n    curve: basis\n    nodeSpacing: 45\n    rankSpacing: 135\n    htmlLabels: true\n---\n\n%% Figure: Administration and Reporting Use Case Diagram\n%% Beaker Breakers Studio\n%% Scope: class management, bulk import, experiment library configuration,\n%%        school analytics, export and the audit trail\n%% Source: Chapter 3 requirements FR-10.1 to FR-10.8, FR-01.5, SR-04\n%%         SRS Section 20, UC-18 Bulk Import Students, UC-19 Manage Classes,\n%%         UC-20 Configure Experiment Library,\n%%         UC-22 Generate Analytics and Export Reports,\n%%         UC-27 Record Audit Entry\n\n%% Shape note: Mermaid has no ellipse shape. Use cases are drawn here with the\n%% stadium shape ([text]). The Graphviz version of this figure uses true UML\n%% ellipses and is the one to place in the report.\n\nflowchart LR\n\n    %% ================= Actor =================\n    Admin[\&quot;Administrator\&quot;]\n\n    %% ================= System boundary =================\n    subgraph SYS[\&quot;Beaker Breakers Studio (Administration and Reporting Scope)\&quot;]\n        UC19([\&quot;UC-19&lt;br/&gt;Manage Classes\&quot;])\n        MKCLS([\&quot;Create and Modify a Class\&quot;])\n        ASSIGN([\&quot;Assign Students and Teachers&lt;br/&gt;to a Class\&quot;])\n\n        UC18([\&quot;UC-18&lt;br/&gt;Bulk Import Students\&quot;])\n        LIMIT([\&quot;Accept a File of No More&lt;br/&gt;Than 500 Rows\&quot;])\n        VALID([\&quot;Validate Every Row of the File\&quot;])\n        FAILED([\&quot;Create No Account and&lt;br/&gt;Report Each Failing Row\&quot;])\n\n        UC20([\&quot;UC-20&lt;br/&gt;Configure Experiment Library\&quot;])\n        TOGGLE([\&quot;Enable or Disable an&lt;br/&gt;Experiment for a Class\&quot;])\n\n        UC22([\&quot;UC-22&lt;br/&gt;Generate Analytics and&lt;br/&gt;Export Reports\&quot;])\n        METRIC([\&quot;Compute Certification Rate, Completion&lt;br/&gt;Rate and Readiness Distribution\&quot;])\n        EXPORT([\&quot;Export as Portable Document Format&lt;br/&gt;or Delimited Text\&quot;])\n\n        UC27([\&quot;UC-27&lt;br/&gt;Record Audit Entry\&quot;])\n        IMMUT([\&quot;Write an Entry That Cannot&lt;br/&gt;Be Modified or Deleted\&quot;])\n        RETAIN([\&quot;Retain the Entry for No&lt;br/&gt;Less Than 7 Years\&quot;])\n\n        %% context: the other operations that must be audited\n        UC17([\&quot;UC-17&lt;br/&gt;Manage User Accounts\&quot;])\n        UC21([\&quot;UC-21&lt;br/&gt;Manage Certificate Registry\&quot;])\n    end\n\n    %% ================= Actor associations =================\n    Admin --- UC19\n    Admin --- UC18\n    Admin --- UC20\n    Admin --- UC22\n    Admin --- UC17\n    Admin --- UC21\n\n    %% ================= Include relationships =================\n    UC19 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-10.1\&quot;| MKCLS\n    UC19 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-10.1\&quot;| ASSIGN\n\n    UC18 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-10.2\&quot;| LIMIT\n    UC18 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-10.3\&quot;| VALID\n\n    UC20 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-10.4\&quot;| TOGGLE\n\n    UC22 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-10.6\&quot;| METRIC\n    UC22 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-10.7\&quot;| EXPORT\n    UC22 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-10.8\&quot;| UC27\n\n    UC17 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-10.8\&quot;| UC27\n    UC18 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-10.8\&quot;| UC27\n    UC21 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-10.8\&quot;| UC27\n\n    UC27 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-10.8\&quot;| IMMUT\n    UC27 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-10.8\&quot;| RETAIN\n\n    %% ================= Extend relationship =================\n    FAILED -.-&gt;|\&quot;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt; FR-10.3&lt;br/&gt;[any row fails validation]\&quot;| UC18\n\n    %% ================= Constraint notes =================\n    %% FR-10.2: a bulk file of up to 500 rows completes within 60 seconds.\n    %% FR-10.3: if any row fails validation, no account is created from that\n    %%          file at all, and each failing row is reported individually.\n    %% FR-10.7: an export completes within 10 seconds.\n    %% FR-10.8: every administrative account operation, certificate issue and\n    %%          report export is recorded as an immutable entry.\n\n    %% ================= Styling (outline only, no fill colour) =================\n    classDef actor fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000\n    classDef uc fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000\n\n    class Admin actor\n    class UC19,MKCLS,ASSIGN,UC18,LIMIT,VALID,FAILED,UC20,TOGGLE uc\n    class UC22,METRIC,EXPORT,UC27,IMMUT,RETAIN,UC17,UC21 uc\n\n    style SYS fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="41">
          <mxCell connectable="0" parent="-DrFvxi9EPpmsSaKXJQn-44" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
