<mxfile host="Electron">
  <diagram id="IYLc6UDSmEtjI2gEuBeV" name="Page-1">
    <mxGraphModel dx="1511" dy="963" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  theme: neutral\n  themeVariables:\n    fontFamily: Arial\n    fontSize: 15px\n    lineColor: \&quot;#000000\&quot;\n    edgeLabelBackground: \&quot;#ffffff\&quot;\n  flowchart:\n    curve: basis\n    nodeSpacing: 45\n    rankSpacing: 120\n    htmlLabels: true\n---\n\n%% Figure: Login Use Case Diagram\n%% Beaker Breakers Studio\n%% Scope: authentication and account access only\n%% Source: Chapter 3 requirements FR-01.1 to FR-01.6\n%%         SRS Section 20, UC-01 Log In, UC-07 Reset Password, UC-17 Manage User Accounts\n\n%% Notation note: Mermaid draws no hollow triangle arrowhead, so the actor\n%% generalisation from Student, Teacher and Administrator to Registered User\n%% is drawn as a plain solid line and labelled. In the final UML rendering it\n%% is a solid line with a hollow triangle pointing at Registered User.\n\nflowchart LR\n\n    %% ================= Actors =================\n    Student[\&quot;Student\&quot;]\n    Teacher[\&quot;Teacher\&quot;]\n    Admin[\&quot;Administrator\&quot;]\n    RegUser[\&quot;Registered User\&quot;]\n    MAIL[\&quot;Transactional Email Service&lt;br/&gt;(SendGrid)&lt;br/&gt;&amp;lt;&amp;lt;external&amp;gt;&amp;gt;\&quot;]\n\n    %% ================= System boundary =================\n    subgraph SYS[\&quot;Beaker Breakers Studio (Authentication Scope)\&quot;]\n        UC01((UC-01&lt;br/&gt;Log In))\n        VAL((Validate&lt;br/&gt;Credentials))\n        TOKEN((Issue Access&lt;br/&gt;Token))\n        DASH((Load Role&lt;br/&gt;Dashboard))\n        LOCK((Refuse Further&lt;br/&gt;Login Attempts))\n        UC07((UC-07&lt;br/&gt;Reset Password))\n        SEND((Send Password&lt;br/&gt;Reset Email))\n        VTOK((Validate Single&lt;br/&gt;Use Reset Token))\n        UC17((UC-17&lt;br/&gt;Manage User&lt;br/&gt;Accounts))\n    end\n\n    %% ================= Actor generalisation =================\n    Student --- RegUser\n    Teacher --- RegUser\n    Admin --- RegUser\n\n    %% ================= Actor associations =================\n    RegUser --- UC01\n    RegUser --- UC07\n    Admin --- UC17\n\n    %% ================= Include relationships =================\n    UC01 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-01.1\&quot;| VAL\n    UC01 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-01.2\&quot;| TOKEN\n    UC01 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-01.1\&quot;| DASH\n    UC07 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-01.3\&quot;| SEND\n    UC07 -.-&gt;|\&quot;&amp;lt;&amp;lt;include&amp;gt;&amp;gt; FR-01.3\&quot;| VTOK\n\n    %% ================= Extend relationships =================\n    LOCK -.-&gt;|\&quot;&amp;lt;&amp;lt;extend&amp;gt;&amp;gt; FR-01.4&lt;br/&gt;after 5 failed attempts in 15 minutes\&quot;| UC01\n\n    %% ================= External participation =================\n    SEND --- MAIL\n\n    %% ================= Constraint note =================\n    %% FR-01.5 and FR-01.6: only the Administrator creates accounts.\n    %% There is no self registration use case, so no actor associates\n    %% with an account creation use case other than the Administrator.\n\n    %% ================= Styling (outline only, no fill colour) =================\n    classDef actor fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000\n    classDef ext fill:#ffffff,stroke:#000000,stroke-width:1.5px,stroke-dasharray:5 4,color:#000000\n    classDef uc fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000\n\n    class Student,Teacher,Admin,RegUser actor\n    class MAIL ext\n    class UC01,VAL,TOKEN,DASH,LOCK,UC07,SEND,VTOK,UC17 uc\n\n    style SYS fill:#ffffff,stroke:#000000,stroke-width:1.5px,color:#000000\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="30">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
