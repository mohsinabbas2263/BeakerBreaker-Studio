flowchart TB
  ST((Start)) --> A1["Open experiment from library"]
  A1 --> D0{"Safety certification valid?"}
  D0 -- no --> A0["Redirect to Safety Certification"] --> D0
  D0 -- yes --> D1{"Readiness assessment passed?"}
  D1 -- no --> A2["Present theory / safety questions<br/>and evaluate score"] --> D1
  D1 -- yes --> A3["Load 3D laboratory scene,<br/>equipment and chemicals"]
  A3 --> A4["Student performs next step<br/>(select / place / measure)"]
  A4 --> D2{"Action matches step rule?"}
  D2 -- yes --> A5["Record observation, advance step,<br/>persist state"]
  D2 -- no --> A6["Show corrective feedback<br/>(and safety warning if unsafe)"] --> A4
  A5 --> D3{"All steps complete?"}
  D3 -- no --> A4
  D3 -- yes --> A7["Evaluate result and<br/>performance dimensions"]
  A7 --> A8["Update progress, award points,<br/>evaluate badge criteria"]
  A8 --> EN(((End)))
